@model AkuDevs.Models.TechStack
@{
    ViewData["Title"] = "Yeni Teknoloji Ekle";
}

<div class="mb-8">
    <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold shadow-[0_0_15px_rgba(147,51,234,0.3)] hover:shadow-[0_0_25px_rgba(147,51,234,0.6)] transition-all hover:-translate-x-1 mb-6">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Geri Dön
    </a>
    <h2 class="text-3xl font-black text-white tracking-tight">Yeni Teknoloji Ekle</h2>
</div>

<div class="relative group max-w-3xl">
    <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl blur opacity-20 transition duration-1000 group-hover:opacity-40 group-hover:duration-200"></div>
    <div class="relative bg-[#141414] border border-white/10 rounded-2xl p-6 md:p-10 shadow-2xl">
        <form asp-action="Create" method="post" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-400 mb-2">Teknoloji Adı (TR)</label>
                    <input asp-for="NameTr" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder-gray-600" placeholder="Örn: React" />
                    <span asp-validation-for="NameTr" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-400 mb-2">Teknoloji Adı (EN)</label>
                    <input asp-for="NameEn" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder-gray-600" placeholder="e.g. React" />
                    <span asp-validation-for="NameEn" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-400 mb-2">Sıralama</label>
                    <input asp-for="OrderIndex" type="number" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" />
                    <span asp-validation-for="OrderIndex" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center gap-3 bg-black/30 p-4 rounded-xl border border-white/5">
                <input asp-for="IsActive" type="checkbox" class="w-5 h-5 accent-blue-500 rounded bg-[#0a0a0a] border-white/10 cursor-pointer" />
                <label class="text-sm font-medium text-white cursor-pointer select-none">Sitede Görünsün mü?</label>
            </div>

            <div class="pt-4 flex justify-end">
                <button type="submit" class="px-8 py-3 rounded-xl font-bold text-white bg-gradient-to-r from-purple-600 to-yellow-500 shadow-lg shadow-purple-500/20 transition-all hover:-translate-y-1 hover:shadow-purple-500/40">
                    Ekle ve Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

