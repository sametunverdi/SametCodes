@model AkuDevs.Models.WorkProcess
@{
    ViewData["Title"] = "Yeni Süreç Ekle";
}

<div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
    <div>
        <h2 class="text-3xl font-black text-white tracking-tight mb-2">Yeni Süreç Ekle</h2>
        <p class="text-gray-400">Ana sayfadaki süreç bölümüne yeni bir adım ekliyorsunuz.</p>
    </div>
    <a asp-action="Index" class="relative group px-6 py-2.5 rounded-xl font-bold text-gray-300 bg-white/5 hover:bg-white/10 transition-all flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Geri Dön
    </a>
</div>

<div class="bg-[#141414] border border-white/5 rounded-2xl p-6 md:p-8 shadow-2xl">
    <form asp-action="Create" method="post" class="space-y-6">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Adım Numarası</label>
                <input asp-for="StepNumber" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all" placeholder="Örn: 01" />
                <span asp-validation-for="StepNumber" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Sıralama (0, 1, 2...)</label>
                <input asp-for="OrderIndex" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all" />
                <span asp-validation-for="OrderIndex" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Animasyon Gecikmesi (sn)</label>
                <input asp-for="AnimationDelay" step="0.1" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all" placeholder="0.0, 0.1, 0.2" />
                <span asp-validation-for="AnimationDelay" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Başlık (TR)</label>
                <input asp-for="TitleTr" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all" />
                <span asp-validation-for="TitleTr" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Başlık (EN)</label>
                <input asp-for="TitleEn" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all" />
                <span asp-validation-for="TitleEn" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Açıklama (TR)</label>
                <textarea asp-for="DescriptionTr" rows="3" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all"></textarea>
                <span asp-validation-for="DescriptionTr" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-400 mb-2">Açıklama (EN)</label>
                <textarea asp-for="DescriptionEn" rows="3" class="w-full bg-[#0a0a0a] border border-white/10 text-white rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 transition-all"></textarea>
                <span asp-validation-for="DescriptionEn" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div>
            <label class="flex items-center gap-3 p-4 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 transition-colors">
                <input asp-for="IsActive" class="w-5 h-5 rounded border-gray-600 text-blue-600 focus:ring-blue-600 bg-[#0a0a0a]" />
                <span class="text-white font-medium">Bu süreç aktif edilsin mi?</span>
            </label>
        </div>

        <button type="submit" class="w-full py-4 rounded-xl font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-0.5 transition-all">
            Ekle ve Kaydet
        </button>
    </form>
</div>
