@model AkuDevs.Models.HeroSection

@{
    ViewData["Title"] = "Hero Ayarları";
    const string inputCls = "w-full bg-[#0b0b0b] border border-white/10 text-white text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/20 transition placeholder-gray-600";
}

<div class="mb-6 md:mb-8">
    <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Hero (Giriş) Yönetimi</h2>
    <p class="text-gray-400 text-sm md:text-base mt-1">Ana sayfanın en üstündeki rozet, başlık ve açıklama metinleri. Sağdaki önizleme yazdıkça güncellenir.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center gap-3 text-emerald-400 text-sm">
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        <span class="font-medium">@TempData["Success"]</span>
    </div>
}

<form asp-action="Index" method="post" id="heroForm">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4"></div>

    <div class="grid grid-cols-1 xl:grid-cols-5 gap-6">

        <!-- FORM -->
        <div class="xl:col-span-3 space-y-5">

            <!-- Rozet -->
            <section class="bg-[#121212] border border-white/10 rounded-2xl p-5 md:p-6">
                <h3 class="text-white font-bold mb-4 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-red-500"></span>Rozet (üst küçük yazı)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-red-500/15 text-red-400 text-[10px] font-bold">TR</span>Türkçe</label>
                        <input asp-for="BadgeTr" data-pv="badge" data-lang="tr" class="@inputCls" placeholder="Örn: FREELANCE WEB GELİŞTİRİCİ" />
                        <span asp-validation-for="BadgeTr" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-white/10 text-gray-300 text-[10px] font-bold">EN</span>English</label>
                        <input asp-for="BadgeEn" data-pv="badge" data-lang="en" class="@inputCls" placeholder="e.g. FREELANCE WEB DEVELOPER" />
                        <span asp-validation-for="BadgeEn" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>

            <!-- Beyaz başlık -->
            <section class="bg-[#121212] border border-white/10 rounded-2xl p-5 md:p-6">
                <h3 class="text-white font-bold mb-4 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-white"></span>Beyaz başlık (1. satır)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-red-500/15 text-red-400 text-[10px] font-bold">TR</span>Türkçe</label>
                        <input asp-for="TitleWhiteTr" data-pv="white" data-lang="tr" class="@inputCls" placeholder="Örn: Dijital Vizyonunuzu" />
                        <span asp-validation-for="TitleWhiteTr" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-white/10 text-gray-300 text-[10px] font-bold">EN</span>English</label>
                        <input asp-for="TitleWhiteEn" data-pv="white" data-lang="en" class="@inputCls" placeholder="e.g. Turn Your Digital Vision" />
                        <span asp-validation-for="TitleWhiteEn" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>

            <!-- Kırmızı başlık -->
            <section class="bg-[#121212] border border-white/10 rounded-2xl p-5 md:p-6">
                <h3 class="text-white font-bold mb-4 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-gradient-to-r from-red-700 to-red-400"></span>Kırmızı / gradyan başlık (2. satır)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-red-500/15 text-red-400 text-[10px] font-bold">TR</span>Türkçe</label>
                        <input asp-for="TitleRedTr" data-pv="red" data-lang="tr" class="@inputCls" placeholder="Örn: Gerçeğe Dönüştürün" />
                        <span asp-validation-for="TitleRedTr" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-white/10 text-gray-300 text-[10px] font-bold">EN</span>English</label>
                        <input asp-for="TitleRedEn" data-pv="red" data-lang="en" class="@inputCls" placeholder="e.g. Into Reality" />
                        <span asp-validation-for="TitleRedEn" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>

            <!-- Açıklama -->
            <section class="bg-[#121212] border border-white/10 rounded-2xl p-5 md:p-6">
                <h3 class="text-white font-bold mb-4 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-gray-500"></span>Açıklama metni</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-red-500/15 text-red-400 text-[10px] font-bold">TR</span>Türkçe</label>
                        <textarea asp-for="DescriptionTr" rows="4" data-pv="desc" data-lang="tr" class="@inputCls resize-none" placeholder="Açıklama girin..."></textarea>
                        <span asp-validation-for="DescriptionTr" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-2"><span class="px-1.5 py-0.5 rounded bg-white/10 text-gray-300 text-[10px] font-bold">EN</span>English</label>
                        <textarea asp-for="DescriptionEn" rows="4" data-pv="desc" data-lang="en" class="@inputCls resize-none" placeholder="Enter description..."></textarea>
                        <span asp-validation-for="DescriptionEn" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>
        </div>

        <!-- ÖNİZLEME -->
        <aside class="xl:col-span-2">
            <div class="xl:sticky xl:top-6 bg-[#121212] border border-white/10 rounded-2xl p-5 md:p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-white font-bold">Canlı önizleme</h3>
                    <div class="inline-flex p-0.5 rounded-full bg-black/60 border border-white/10 text-xs font-bold">
                        <button type="button" data-plang="tr" class="plang px-3 py-1 rounded-full">TR</button>
                        <button type="button" data-plang="en" class="plang px-3 py-1 rounded-full">EN</button>
                    </div>
                </div>
                <div class="relative overflow-hidden rounded-xl bg-black px-4 py-10 text-center">
                    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-32 rounded-full bg-red-600/20 blur-3xl pointer-events-none"></div>
                    <div class="relative">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-red-600/50 bg-black/40 text-red-500 text-[10px] font-bold uppercase tracking-wider mb-4">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span><span id="pv-badge"></span>
                        </span>
                        <h4 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight">
                            <span id="pv-white"></span><br />
                            <span id="pv-red" class="hero-red-text"></span>
                        </h4>
                        <p id="pv-desc" class="text-gray-300 text-xs sm:text-sm mt-3 leading-relaxed"></p>
                        <div class="flex flex-wrap justify-center gap-2 mt-5">
                            <span class="grad-red px-4 py-2 rounded-full text-white text-xs font-bold">Projelerimi İncele</span>
                            <span class="px-4 py-2 rounded-full border border-white/20 bg-black/50 text-white text-xs font-bold">Benimle Çalış</span>
                        </div>
                    </div>
                </div>
                <p class="text-gray-500 text-xs mt-3">Butonlar sabittir, buradan değişmez. Web sitesi şu an Türkçe metinleri gösterir.</p>
            </div>
        </aside>
    </div>

    <!-- KAYDET (mobilde de altta sabit) -->
    <div class="sticky bottom-0 mt-6 -mx-6 md:-mx-10 px-6 md:px-10 py-4 bg-[#0a0a0a]/90 backdrop-blur border-t border-white/10 flex justify-end">
        <button type="submit" class="grad-red btn-glow w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl font-bold text-white hover:-translate-y-0.5 transition-all">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Değişiklikleri Kaydet
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var lang = 'tr';
            var map = { badge: 'pv-badge', white: 'pv-white', red: 'pv-red', desc: 'pv-desc' };
            var inputs = document.querySelectorAll('[data-pv]');
            function render() {
                inputs.forEach(function (el) {
                    if (el.dataset.lang === lang) {
                        document.getElementById(map[el.dataset.pv]).textContent = el.value;
                    }
                });
                document.querySelectorAll('.plang').forEach(function (b) {
                    var on = b.dataset.plang === lang;
                    b.classList.toggle('bg-red-600', on);
                    b.classList.toggle('text-white', on);
                    b.classList.toggle('text-gray-400', !on);
                });
            }
            inputs.forEach(function (el) { el.addEventListener('input', render); });
            document.querySelectorAll('.plang').forEach(function (b) {
                b.addEventListener('click', function () { lang = b.dataset.plang; render(); });
            });
            render();
        })();
    </script>
}
