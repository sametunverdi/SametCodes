@model AkuDevs.Models.Project
@{
    ViewData["Title"] = Model.TitleTr;
    var gallery = Model.Gallery?.ToList() ?? new List<AkuDevs.Models.ProjectImage>();
    bool hasGallery = gallery.Count > 0;
}

<!-- PROJECT HERO -->
<section class="relative pt-40 pb-20 bg-[#fdfbf7] overflow-hidden border-b border-gray-200/50">
    <div class="max-w-5xl mx-auto px-4 relative z-10">
        <div class="mb-10 text-center reveal">
            <span class="inline-block mb-6 px-4 py-1.5 rounded-full bg-amber-500/10 text-amber-600 text-sm font-bold uppercase tracking-widest" data-i18n-dyn-tr="@Model.CategoryTr" data-i18n-dyn-en="@Model.CategoryEn">@Model.CategoryTr</span>
            <h1 class="text-5xl md:text-7xl font-extrabold text-black mb-6 tracking-tight leading-tight" data-i18n-dyn-tr="@Model.TitleTr" data-i18n-dyn-en="@Model.TitleEn">@Model.TitleTr</h1>
        </div>
        
        <div class="flex flex-wrap justify-center gap-8 py-8 border-y border-gray-200/60 reveal" style="--d:.2s">
            <div class="text-center px-4">
                <h4 class="text-gray-400 uppercase text-xs font-bold tracking-widest mb-1">Kategori</h4>
                <p class="text-black font-bold" data-i18n-dyn-tr="@Model.CategoryTr" data-i18n-dyn-en="@Model.CategoryEn">@Model.CategoryTr</p>
            </div>
            
            @if(!string.IsNullOrEmpty(Model.ProjectUrl) && Model.ProjectUrl != "#")
            {
                <div class="text-center px-4">
                    <h4 class="text-gray-400 uppercase text-xs font-bold tracking-widest mb-1">Bağlantı</h4>
                    <a href="@Model.ProjectUrl" target="_blank" class="text-amber-600 font-bold hover:text-black transition-colors underline underline-offset-4">Siteyi Ziyaret Et</a>
                </div>
            }
        </div>
    </div>
</section>

<!-- MAIN SHOWCASE IMAGE SLIDER -->
<section class="bg-[#fdfbf7] pb-24 relative px-4">
    <div class="max-w-7xl mx-auto pt-10 relative z-20 reveal" style="--d:.3s">
        
        <div class="relative group rounded-[2.5rem] overflow-hidden shadow-2xl shadow-black/10 aspect-[16/9] bg-gray-100 border border-gray-200/50">
            <!-- Slider Track -->
            <div id="project-slider" class="flex w-full h-full transition-transform duration-700 ease-out cursor-pointer" onclick="openLightbox()">
                <!-- Ana Resim Her Zaman İlk Sırada -->
                <div class="w-full h-full flex-shrink-0">
                    <img src="@Model.ImageUrl" alt="@Model.TitleTr" class="w-full h-full object-cover">
                </div>
                
                @if(hasGallery)
                {
                    foreach(var img in gallery)
                    {
                        <div class="w-full h-full flex-shrink-0">
                            <img src="@img.ImageUrl" alt="Gallery Image" class="w-full h-full object-cover">
                        </div>
                    }
                }
            </div>

            @if(hasGallery)
            {
                <!-- Navigation Arrows -->
                <button onclick="moveSlide(-1, event)" class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-black/30 hover:bg-black/60 text-white backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button onclick="moveSlide(1, event)" class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-black/30 hover:bg-black/60 text-white backdrop-blur-sm transition-all opacity-0 group-hover:opacity-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>

                <!-- Dots -->
                <div id="slider-dots" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2">
                    <button onclick="goToSlide(0, event)" class="w-3 h-3 rounded-full bg-white shadow-md transition-all"></button>
                    @{
                        int dotIndex = 1;
                        foreach(var img in gallery)
                        {
                            <button onclick="goToSlide(@dotIndex, event)" class="w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 shadow-md transition-all"></button>
                            dotIndex++;
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- FULLSCREEN LIGHTBOX -->
<div id="lightbox" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-lg hidden flex-col justify-center items-center opacity-0 transition-opacity duration-300">
    <button onclick="closeLightbox()" class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    
    @if(hasGallery)
    {
        <button onclick="moveSlide(-1, event)" class="absolute left-6 top-1/2 -translate-y-1/2 w-14 h-14 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button onclick="moveSlide(1, event)" class="absolute right-6 top-1/2 -translate-y-1/2 w-14 h-14 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
    }

    <div class="max-w-[90vw] max-h-[90vh] relative">
        <img id="lightbox-img" src="" alt="Tam Boyut" class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl transition-opacity duration-200">
    </div>
</div>

<!-- ABOUT PROJECT -->
<section class="py-24 bg-white px-4">
    <div class="max-w-4xl mx-auto reveal">
        <div class="grid gap-12">
            <div>
                <h2 class="text-2xl font-black text-black mb-6">Proje Detayları</h2>
                <p class="text-gray-600 text-lg leading-relaxed mb-6" data-i18n-dyn-tr="@Model.DescriptionTr" data-i18n-dyn-en="@Model.DescriptionEn">
                    @Model.DescriptionTr
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-32 bg-amber-500 px-4 text-center">
    <div class="max-w-3xl mx-auto reveal">
        <h2 class="text-4xl md:text-6xl font-black text-black mb-8 leading-tight">Bu projeyi beğendiniz mi? <br>Birlikte harika işler yapabiliriz.</h2>
        <a href="/#contact" class="inline-flex px-10 py-5 rounded-full bg-black text-white font-extrabold text-lg hover:scale-105 transition-transform shadow-2xl">
            Projenizden Bahsedin
        </a>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const items = document.querySelectorAll('.reveal');
            if (reduce || !('IntersectionObserver' in window)) {
                items.forEach(el => el.classList.add('is-visible'));
            } else {
                const io = new IntersectionObserver((entries) => {
                    entries.forEach(e => {
                        if (e.isIntersecting) { 
                            e.target.classList.add('is-visible'); 
                            io.unobserve(e.target); 
                        }
                    });
                }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
                items.forEach(el => io.observe(el));
            }
        });

        // Slider Logic
        let currentSlide = 0;
        const totalSlides = @(hasGallery ? gallery.Count + 1 : 1);
        const slider = document.getElementById('project-slider');
        const dots = document.getElementById('slider-dots') ? document.getElementById('slider-dots').children : [];
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');

        window.moveSlide = (dir, event) => {
            if(event) event.stopPropagation();
            if(totalSlides <= 1) return;
            currentSlide = (currentSlide + dir + totalSlides) % totalSlides;
            updateSlider();
            
            if(!lightbox.classList.contains('hidden')) {
                const currentImg = slider.children[currentSlide].querySelector('img').src;
                lightboxImg.style.opacity = 0;
                setTimeout(() => {
                    lightboxImg.src = currentImg;
                    lightboxImg.style.opacity = 1;
                }, 150);
            }
        };

        window.goToSlide = (idx, event) => {
            if(event) event.stopPropagation();
            currentSlide = idx;
            updateSlider();
        };

        function updateSlider() {
            slider.style.transform = `translateX(-${currentSlide * 100}%)`;
            for(let i=0; i<dots.length; i++){
                if(i === currentSlide) {
                    dots[i].className = "w-3 h-3 rounded-full bg-white shadow-md transition-all";
                } else {
                    dots[i].className = "w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 shadow-md transition-all";
                }
            }
        }

        window.openLightbox = () => {
            const currentImg = slider.children[currentSlide].querySelector('img').src;
            lightboxImg.src = currentImg;
            lightboxImg.style.opacity = 1;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            setTimeout(() => lightbox.classList.remove('opacity-0'), 10);
            document.body.style.overflow = 'hidden'; 
        };

        window.closeLightbox = () => {
            lightbox.classList.add('opacity-0');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                document.body.style.overflow = '';
            }, 300);
        };
    </script>
}
