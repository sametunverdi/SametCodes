@{
    ViewData["Title"] = "Hakkımda";
}

<!-- HERO SECTION -->
<section class="min-h-screen relative flex items-center justify-center pt-24 pb-16 overflow-hidden bg-[#0a0505] text-white">
    <!-- Animated bg shapes -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-red-900/20 blur-[120px] animate-pulse"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-amber-600/10 blur-[150px]" style="animation: pulse 8s infinite alternate;"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full grid md:grid-cols-2 gap-16 items-center">
        <!-- Text Content -->
        <div class="reveal" style="--d:.2s">
            <span class="inline-flex items-center gap-1.5 mb-6 pr-5 pl-2 py-1.5 rounded-full border border-white/20 bg-white/5 backdrop-blur-md shadow-lg shadow-red-500/10">
                <img src="/images/sametcodes-logo.png" class="w-10 h-10 object-contain scale-[1.4] -ml-1" alt="Logo" />
                <span class="text-lg tracking-tight font-black"><span class="grad-red-text">Samet</span><span class="text-white">Codes</span></span>
            </span>
            <h1 class="text-5xl md:text-7xl font-black mb-8 leading-tight drop-shadow-lg">
                Sadece kod <br>yazmıyorum, <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-amber-500 animate-pulse">Miras</span> inşa ediyorum.
            </h1>
            <p class="text-gray-400 text-lg md:text-xl leading-relaxed mb-10 max-w-lg">
                Sıradan, birbirinin kopyası şablonlara karşıyım. Amacım sadece 'çalışan' bir site yapmak değil; hız, performans ve mükemmel tasarımı bir araya getirerek işinizi büyütecek dijital ortak olmak.
            </p>
            <a href="#story" class="inline-flex items-center gap-4 group cursor-pointer">
                <div class="w-14 h-14 rounded-full bg-white text-black flex items-center justify-center transition-transform duration-500 group-hover:scale-110 shadow-[0_0_30px_rgba(255,255,255,0.3)]">
                    <svg class="w-6 h-6 transform group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                </div>
                <span class="font-bold text-lg tracking-wide group-hover:text-amber-500 transition-colors">Hikayemi Keşfet</span>
            </a>
        </div>
        
        <!-- Image/Visual -->
        <div class="relative reveal" style="--d:.4s">
            <!-- Glowing frame -->
            <div class="absolute inset-0 bg-gradient-to-tr from-amber-500 to-red-600 rounded-[3rem] transform rotate-3 scale-105 opacity-40 blur-2xl animate-pulse"></div>
            <!-- Main Photo -->
            <div class="relative rounded-[3rem] overflow-hidden border border-white/10 aspect-[4/5] bg-gray-900 group shadow-2xl">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80" alt="Samet Workspace" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 opacity-80 group-hover:opacity-100 grayscale group-hover:grayscale-0">
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0505] via-transparent to-transparent opacity-80"></div>
                <!-- Floating Badge -->
                <div class="absolute bottom-8 left-8 bg-white/10 backdrop-blur-xl border border-white/20 p-4 rounded-2xl flex items-center gap-4 transform transition-transform duration-500 hover:-translate-y-2 hover:shadow-[0_10px_30px_rgba(242,159,5,0.3)]">
                    <div class="text-4xl font-black text-amber-500">5+</div>
                    <div class="text-white text-sm font-bold uppercase tracking-wider leading-tight">Yıllık<br>Deneyim</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HİKAYEM & FELSEFEM -->
<section id="story" class="py-32 bg-[#fdfbf7] relative border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4">
        <!-- Story Text -->
        <div class="max-w-4xl mx-auto text-center mb-24 reveal">
            <h2 class="text-4xl md:text-5xl font-black text-black mb-8">Neden Buradayım?</h2>
            <p class="text-gray-600 text-xl md:text-2xl leading-relaxed font-medium">
                Yazılım dünyasına adım attığım ilk günden beri tek bir şeye inandım: <strong class="text-red-600">Detaylar fark yaratır.</strong> 
                Birçok ajans işi hızlıca teslim edip geçmeye odaklanırken, ben her pikselin, her milisaniyenin hesabını yapıyorum.
                Çünkü doğru yazılmış temiz bir kod ve kusursuz bir UI tasarımı, bir markanın en büyük dijital silahıdır.
            </p>
        </div>

        <!-- Philosophy Cards -->
                <div class="grid md:grid-cols-3 gap-8">
            @if(ViewBag.Features != null)
            {
                var delayFeature = 0.0;
                foreach(var f in (IEnumerable<AkuDevs.Models.AboutFeature>)ViewBag.Features)
                {
                    <div class="bg-white p-10 rounded-[2.5rem] shadow-xl shadow-black/5 border border-gray-100 reveal group hover:-translate-y-4 hover:shadow-2xl transition-all duration-500" style="--d:@(delayFeature)s">
                        <div class="w-20 h-20 rounded-2xl bg-@(f.ColorClass)-50 text-@(f.ColorClass)-600 flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-@(f.ColorClass)-600 group-hover:text-white transition-all duration-500 shadow-sm">
                            @Html.Raw(f.IconSvg)
                        </div>
                        <h3 class="text-2xl font-bold text-black mb-4">@f.Title</h3>
                        <p class="text-gray-600 leading-relaxed">@f.Description</p>
                    </div>
                    delayFeature += 0.2;
                }
            }
        </div>
    </div>
</section>

<!-- SKILLS SECTION -->
<section class="py-24 bg-[#fdfbf7] relative">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16 reveal">
            <span class="inline-block mb-4 px-4 py-1.5 rounded-full bg-red-50 text-red-600 text-sm font-bold uppercase tracking-widest border border-red-100">Yetenekler</span>
            <h2 class="text-4xl md:text-5xl font-black text-black mb-6 tracking-tight">Teknik & Profesyonel <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-amber-500">Becerilerim</span></h2>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            @if(ViewBag.Skills != null)
            {
                var delay = 0.0;
                foreach(var skill in (IEnumerable<AkuDevs.Models.Skill>)ViewBag.Skills)
                {
                    <div class="bg-white p-8 rounded-3xl shadow-lg border border-gray-100 reveal hover:-translate-y-2 transition-transform duration-300" style="--d:@(delay)s">
                        <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-white font-bold text-xl mb-6 shadow-md" style="background-color: @skill.ColorHex;">
                            @skill.IconText
                        </div>
                        <h3 class="text-xl font-bold text-black mb-3">@skill.TitleTr</h3>
                        <p class="text-gray-600 leading-relaxed">@skill.DescriptionTr</p>
                    </div>
                    delay += 0.1;
                }
            }
        </div>
    </div>
</section>
<!-- TECH STACK (Teknoloji Havuzu) -->
<section class="py-32 bg-[#0a0505] text-white relative overflow-hidden">
    <!-- Grid Pattern Background -->
    <div class="absolute inset-0 opacity-20 bg-[linear-gradient(rgba(255,255,255,0.1)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.1)_1px,transparent_1px)] bg-[size:40px_40px]"></div>

    <div class="max-w-7xl mx-auto px-4 text-center mb-16 relative z-10 reveal">
        <h2 class="text-4xl md:text-5xl font-black mb-6">Teknoloji Cephaneliğim</h2>
        <p class="text-gray-400 text-xl max-w-2xl mx-auto">En karmaşık problemleri çözerken güvendiğim, modern ve stabil araçlar.</p>
    </div>
    
    <!-- Floating Tech Orbs (Absolutely positioned for a galaxy effect) -->
    <div class="relative w-full max-w-5xl mx-auto h-[450px] md:h-[600px] reveal" id="tech-orbs">
        @{
            var ts = ViewBag.TechStacks as IEnumerable<AkuDevs.Models.TechStack>;
            var techList = ts != null ? ts.Select(t => t.NameTr).ToList() : new List<string>();
        }
        
        <div class="absolute top-[10%] left-[20%] w-24 h-24 md:w-32 md:h-32 rounded-full bg-white/5 border border-white/10 backdrop-blur-md flex items-center justify-center font-bold text-xl md:text-2xl text-purple-500 shadow-[0_0_50px_rgba(168,85,247,0.2)] animate-[float_6s_ease-in-out_infinite] hover:scale-125 transition-transform duration-300 text-center px-2">@(techList.Count > 0 ? techList[0] : "C#")</div>
        
        <div class="absolute top-[30%] right-[15%] w-28 h-28 md:w-40 md:h-40 rounded-full bg-white/5 border border-white/10 backdrop-blur-md flex items-center justify-center font-bold text-center text-lg md:text-xl text-blue-500 shadow-[0_0_50px_rgba(59,130,246,0.2)] animate-[float_8s_ease-in-out_infinite_reverse] hover:scale-125 transition-transform duration-300 px-2">@(techList.Count > 1 ? techList[1] : "ASP.NET Core")</div>
        
        <div class="absolute bottom-[20%] left-[10%] w-20 h-20 md:w-28 md:h-28 rounded-full bg-white/5 border border-white/10 backdrop-blur-md flex items-center justify-center font-bold text-base md:text-lg text-red-500 shadow-[0_0_50px_rgba(239,68,68,0.2)] animate-[float_7s_ease-in-out_infinite] hover:scale-125 transition-transform duration-300 text-center px-2">@(techList.Count > 2 ? techList[2] : "SQL")</div>
        
        <div class="absolute bottom-[10%] right-[30%] w-32 h-32 md:w-48 md:h-48 rounded-full bg-white/5 border border-white/10 backdrop-blur-md flex items-center justify-center font-bold text-2xl md:text-3xl text-cyan-400 shadow-[0_0_50px_rgba(34,211,238,0.2)] animate-[float_9s_ease-in-out_infinite_0.5s] hover:scale-125 transition-transform duration-300 text-center px-2">@(techList.Count > 3 ? techList[3] : "Tailwind CSS")</div>
        
        <!-- Center Main Orb -->
        <div class="absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2 w-40 h-40 md:w-64 md:h-64 rounded-full bg-gradient-to-br from-red-600 to-red-900 flex flex-col items-center justify-center font-black text-white shadow-[0_0_100px_rgba(214,31,31,0.4)] hover:scale-110 transition-transform duration-500 z-20">
            <span class="text-2xl md:text-4xl tracking-tighter">SametCodes</span>
            <span class="text-xs md:text-sm font-bold tracking-widest uppercase opacity-80 mt-2">Core</span>
        </div>
        
        <div class="absolute top-[20%] left-[60%] w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/5 border border-white/10 backdrop-blur-md flex items-center justify-center font-bold text-sm md:text-base text-yellow-400 shadow-[0_0_50px_rgba(250,204,21,0.2)] animate-[float_5s_ease-in-out_infinite_1s] hover:scale-125 transition-transform duration-300 text-center px-2">@(techList.Count > 4 ? techList[4] : "JS/ES6")</div>
    </div>
</section>



@section Scripts {
    <style>
        @@keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(2deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const items = document.querySelectorAll('.reveal');
            if (reduce || !('IntersectionObserver' in window)) {
                items.forEach(el => el.classList.add('is-visible'));
                return;
            }
            const io = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            items.forEach(el => io.observe(el));
        });
    </script>
}



