</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // Hero Animation
            if (!reduce && window.gsap) {
                gsap.from(".hero-content", { y: 40, opacity: 0, duration: 1.2, ease: "power3.out", delay: 0.2 });
            }

            // IntersectionObserver for reveal elements
            const items = document.querySelectorAll('.reveal');
            if (reduce || !('IntersectionObserver' in window)) {
                items.forEach(el => el.classList.add('is-visible'));
            } else {
                const io = new IntersectionObserver((entries) => {
                    entries.forEach(e => {
                        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
                    });
                }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
                items.forEach(el => io.observe(el));
            }

            // Testimonial Poker Cards Logic
            const tCards = document.querySelectorAll('.testimonial-card');
            let activeIndex = 0;
            let tInterval;
            
            function updateTestimonials() {
                if(!tCards.length) return;
                tCards.forEach((card, i) => {
                    let diff = i - activeIndex;
                    if (diff > Math.floor(tCards.length/2)) diff -= tCards.length;
                    if (diff < -Math.floor(tCards.length/2)) diff += tCards.length;

                    if (diff === 0) {
                        card.style.transform = 'translateX(0) scale(1) translateY(-10px) rotate(0deg)';
                        card.style.zIndex = 30;
                        card.style.opacity = 1;
                        card.style.filter = 'blur(0px)';
                        card.style.visibility = 'visible';
                        card.style.pointerEvents = 'auto';
                    } else {
                        let absDiff = Math.abs(diff);
                        let scale = Math.max(0, 1 - 0.12 * absDiff);
                        let opacity = Math.max(0, 1 - 0.25 * absDiff);
                        // Daha eğimli (poker) bir kart yelpazesi için rotation ve translateY artırıldı
                        card.style.transform = 'translateX(' + (60 * diff) + '%) scale(' + scale + ') translateY(' + (20 * absDiff) + 'px) rotate(' + (8 * diff) + 'deg)';
                        card.style.zIndex = 20 - absDiff;
                        card.style.opacity = opacity;
                        card.style.filter = 'blur(' + (1.2 * absDiff) + 'px)';
                        card.style.visibility = opacity > 0 ? 'visible' : 'hidden';
                        card.style.pointerEvents = opacity > 0 ? 'auto' : 'none';
                    }
                });
            }

            tCards.forEach((card, index) => {
                card.addEventListener('click', () => {
                    activeIndex = index;
                    updateTestimonials();
                    resetInterval();
                });
            });

            document.getElementById('prevTest')?.addEventListener('click', () => {
                if(tCards.length) {
                    activeIndex = (activeIndex - 1 + tCards.length) % tCards.length;
                    updateTestimonials();
                    resetInterval();
                }
            });

            document.getElementById('nextTest')?.addEventListener('click', () => {
                if(tCards.length) {
                    activeIndex = (activeIndex + 1) % tCards.length;
                    updateTestimonials();
                    resetInterval();
                }
            });

            function resetInterval() {
                clearInterval(tInterval);
                tInterval = setInterval(() => {
                    if(tCards.length > 0){
                        activeIndex = (activeIndex + 1) % tCards.length;
                        updateTestimonials();
                    }
                }, 5000);
            }
            
            updateTestimonials();
            resetInterval();

            // Comment Modal Logic
            const cModal = document.getElementById('commentModal');
            const cModalContent = document.getElementById('commentModalContent');
            const avatarGrid = document.getElementById('avatarGrid');
            
            const avatarSeeds = ["Felix", "Aneka", "Jasper", "Missy", "Leo", "Toby", "George", "Milo", "Ginger", "Bella", "Max", "Lola", "Cleo", "Jack", "Luna"];
            const bgColors = ['e5e7eb', 'fcd34d', 'fca5a5', 'bae6fd', 'c4b5fd'];
            
            avatarSeeds.forEach((seed, index) => {
                const bg = bgColors[index % bgColors.length];
                const img = `https://api.dicebear.com/7.x/avataaars/svg?seed=${seed}&backgroundColor=${bg}&mouth=default,smile,twinkle&eyes=default,happy&accessoriesProbability=20&facialHairProbability=10`;
                const div = document.createElement('div');
                div.className = "cursor-pointer rounded-full border-[3px] border-transparent hover:scale-110 transition-transform overflow-hidden shrink-0 w-16 h-16 bg-gray-100 snap-center";
                div.innerHTML = `<img src="${img}" class="w-full h-full object-cover">`;
                div.onclick = () => {
                    Array.from(avatarGrid.children).forEach(c => c.classList.remove('border-[#F29F05]', 'scale-110'));
                    div.classList.add('border-[#F29F05]', 'scale-110');
                    document.getElementById('avatarUrl').value = img;
                };
                avatarGrid.appendChild(div);
            });

            // Star Rating Logic
            const starContainer = document.getElementById('starRatingContainer');
            const ratingInput = document.getElementById('selectedRating');
            let currentRating = 5;

            function renderStars(rating) {
                starContainer.innerHTML = '';
                for(let i=1; i<=5; i++) {
                    const star = document.createElement('div');
                    star.className = `cursor-pointer transition-all hover:scale-110 ` + (i <= rating ? 'text-[#eab308]' : 'text-gray-200');
                    star.innerHTML = `<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`;
                    star.onmouseenter = () => renderStarsPreview(i);
                    star.onmouseleave = () => renderStarsPreview(currentRating);
                    star.onclick = () => {
                        currentRating = i;
                        ratingInput.value = i;
                        renderStarsPreview(i);
                    };
                    starContainer.appendChild(star);
                }
            }

            function renderStarsPreview(rating) {
                Array.from(starContainer.children).forEach((star, index) => {
                    if(index < rating) {
                        star.classList.add('text-[#eab308]');
                        star.classList.remove('text-gray-200');
                    } else {
                        star.classList.add('text-gray-200');
                        star.classList.remove('text-[#eab308]');
                    }
                });
            }
            renderStars(currentRating);

            // Modal Functions
            window.openCommentModal = () => {
                cModal.classList.remove('opacity-0', 'invisible');
                cModalContent.classList.remove('scale-75', 'translate-y-10', 'opacity-0');
                cModalContent.classList.add('scale-100', 'translate-y-0', 'opacity-100');
                document.body.style.overflow = 'hidden';
            };

            window.closeCommentModal = () => {
                cModal.classList.add('opacity-0', 'invisible');
                cModalContent.classList.add('scale-75', 'translate-y-10', 'opacity-0');
                cModalContent.classList.remove('scale-100', 'translate-y-0', 'opacity-100');
                document.body.style.overflow = 'auto';
            };

            cModal.addEventListener('click', (e) => {
                if(e.target === cModal) closeCommentModal();
            });

            document.getElementById('commentForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                try {
                    const response = await fetch(e.target.action, {
                        method: 'POST',
                        body: formData
                    });
                    if(response.ok) {
                        alert(`Harika! Yorumunuz başarıyla alındı ve onay sürecine gönderildi. Teşekkürler!`);
                        closeCommentModal();
                        e.target.reset();
                        renderStars(5);
                        currentRating = 5;
                    } else {
                        alert('Bir hata oluştu. Lütfen tekrar deneyin.');
                    }
                } catch(err) {
                    console.error(err);
                }
            });
        });
    </script>
}


