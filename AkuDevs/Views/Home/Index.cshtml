@model AkuDevs.Models.HeroSection
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- HERO -->
<section class="relative min-h-screen w-full flex items-center justify-center overflow-hidden bg-[#1a1a1a]">
    <video autoplay loop muted playsinline preload="auto" aria-hidden="true" aria-label="Arka plan videosu"
           class="absolute inset-0 w-full h-full object-cover z-0">
        <source src="~/videos/background.mp4" type="video/mp4">
    </video>
    <div class="absolute inset-0 z-10 bg-black/25"></div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-[90%] max-w-3xl h-80 rounded-full bg-[#d61f1f]/20 blur-[100px] pointer-events-none"></div>

    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto pt-32 pb-12 hero-content flex flex-col items-center">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#d61f1f]/50 bg-black/30 text-[#ff3b30] font-bold text-xs mb-6 uppercase tracking-wider backdrop-blur-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d61f1f] animate-pulse"></span>
            <span>@(Model?.BadgeTr ?? "FREELANCE WEB GELİŞTİRİCİ")</span>
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight mb-4 text-white leading-tight">
            @(Model?.TitleWhiteTr ?? "Dijital Vizyonunuzu")<br />
            <span class="hero-red-text">@(Model?.TitleRedTr ?? "Gerçeğe Dönüştürün")</span>
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed font-medium">
            @(Model?.DescriptionTr ?? "Hızlı, SEO uyumlu ve mobil öncelikli premium web tasarımlarıyla markanızı rakiplerinizin bir adım önüne taşıyın.")
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10 w-full">
            <a href="#works" class="grad-red btn-glow w-full sm:w-auto px-8 py-3.5 rounded-full text-white font-bold text-base sm:text-lg hover:scale-105 transition-all">
                Projelerimi İncele
            </a>
            <a href="#contact" class="w-full sm:w-auto px-8 py-3.5 rounded-full border border-white/20 bg-black/50 text-white font-bold text-base sm:text-lg hover:border-white/50 hover:bg-black/70 transition-all backdrop-blur-sm">
                Benimle Çalış
            </a>
        </div>

        <!-- Social Icons -->
        <div class="flex items-center gap-6 text-gray-400">
            @if (ViewBag.SocialMedias != null)
            {
                foreach (var social in (IEnumerable<AkuDevs.Models.SocialMedia>)ViewBag.SocialMedias)
                {
                    var p = ((social.PlatformName ?? "") + (social.Url ?? "") + (social.IconSvg ?? "")).ToLower();
                    var hoverClass = "hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)]";
                    
                    if (p.Contains("linkedin")) hoverClass = "hover:text-[#0a66c2] hover:drop-shadow-[0_0_8px_rgba(10,102,194,0.7)]";
                    else if (p.Contains("whatsapp") || p.Contains("wp") || p.Contains("wa.me")) hoverClass = "hover:text-[#25d366] hover:drop-shadow-[0_0_8px_rgba(37,211,102,0.7)]";
                    else if (p.Contains("instagram") || p.Contains("insta")) hoverClass = "hover:text-[#e1306c] hover:drop-shadow-[0_0_8px_rgba(225,48,108,0.7)]";
                    else if (p.Contains("twitter") || p.Contains("x.com") || p.Contains("twitter.com")) hoverClass = "hover:text-[#1da1f2] hover:drop-shadow-[0_0_8px_rgba(29,161,242,0.7)]";
                    else if (p.Contains("youtube")) hoverClass = "hover:text-[#ff0000] hover:drop-shadow-[0_0_8px_rgba(255,0,0,0.7)]";
                    else if (p.Contains("facebook") || p.Contains("fb")) hoverClass = "hover:text-[#1877f2] hover:drop-shadow-[0_0_8px_rgba(24,119,242,0.7)]";
                    else if (p.Contains("github") || p.Contains("git")) hoverClass = "hover:text-white hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.9)]";
                    else if (p.Contains("mail") || p.Contains("e-posta") || p.Contains("eposta") || p.Contains("mailto:")) hoverClass = "hover:text-[#ea4335] hover:drop-shadow-[0_0_8px_rgba(234,67,53,0.7)]";

                    <a href="@social.Url" target="_blank" rel="noopener" class="@hoverClass hover:-translate-y-1 transition-all duration-300 [&>svg]:w-6 [&>svg]:h-6 flex items-center justify-center">
                        @Html.Raw(social.IconSvg)
                    </a>
                }
            }
        </div>
    </div>
</section>

<!-- HİZMETLER -->
<section id="services" class="scroll-mt-20 bg-[#f8f7f4] py-16 px-4 relative">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10 reveal">
            <span class="inline-block mb-3 px-5 py-1.5 rounded-full bg-gradient-to-r from-indigo-600 via-purple-500 to-indigo-600 bg-[length:200%_auto] animate-[shine_6s_linear_infinite] text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-indigo-500/20">HİZMETLER</span>
            <h2 class="text-4xl md:text-5xl font-extrabold mb-3 text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-500 to-indigo-600 bg-[length:200%_auto] animate-[shine_6s_linear_infinite]">
                Ne Yapıyorum?
            </h2>
            <p class="text-gray-700 max-w-2xl mx-auto text-base md:text-lg font-semibold">Kurumsal kimliğinizi ve vizyonunuzu dijital dünyaya en keskin şekilde yansıtan çözümler üretiyorum.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @if (ViewBag.Services != null)
            {
                var services = ((IEnumerable<AkuDevs.Models.Service>)ViewBag.Services).ToList();
                
                var colorThemes = new[] {
                    new { Title = "text-blue-900", Bg = "bg-blue-500/10 backdrop-blur-md border border-blue-500/20", BoxBg = "bg-blue-500", Icon = "text-white", Hover = "hover:border-blue-400", Shadow = "hover:shadow-[0_8px_30px_rgba(59,130,246,0.3)]" },
                    new { Title = "text-emerald-900", Bg = "bg-emerald-500/10 backdrop-blur-md border border-emerald-500/20", BoxBg = "bg-emerald-500", Icon = "text-white", Hover = "hover:border-emerald-400", Shadow = "hover:shadow-[0_8px_30px_rgba(16,185,129,0.3)]" },
                    new { Title = "text-amber-900", Bg = "bg-amber-500/10 backdrop-blur-md border border-amber-500/20", BoxBg = "bg-amber-500", Icon = "text-white", Hover = "hover:border-amber-400", Shadow = "hover:shadow-[0_8px_30px_rgba(245,158,11,0.3)]" },
                    new { Title = "text-purple-900", Bg = "bg-purple-500/10 backdrop-blur-md border border-purple-500/20", BoxBg = "bg-purple-500", Icon = "text-white", Hover = "hover:border-purple-400", Shadow = "hover:shadow-[0_8px_30px_rgba(168,85,247,0.3)]" },
                    new { Title = "text-rose-900", Bg = "bg-rose-500/10 backdrop-blur-md border border-rose-500/20", BoxBg = "bg-rose-500", Icon = "text-white", Hover = "hover:border-rose-400", Shadow = "hover:shadow-[0_8px_30px_rgba(244,63,94,0.3)]" }
                };

                for (int i = 0; i < services.Count; i++)
                {
                    var s = services[i];
                    bool isLarge = i == 0;
                    var theme = colorThemes[i % colorThemes.Length];
                    
                    if (isLarge)
                    {
                        <!-- Large Card (Left) -->
                        <div class="md:col-span-2 md:row-span-2 relative rounded-[2rem] overflow-hidden group transition-all duration-500 hover:-translate-y-1 reveal flex flex-col h-full @theme.Bg @theme.Hover @theme.Shadow">
                            <!-- Image on top -->
                            <div class="w-full h-48 md:h-[220px] overflow-hidden relative">
                                <img src="@s.ImageUrl" alt="@s.TitleTr" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                <div class="absolute top-5 right-5 w-12 h-12 rounded-xl @theme.BoxBg flex items-center justify-center @theme.Icon shadow-lg group-hover:scale-110 transition-transform z-10">
                                    @Html.Raw(s.IconSvg)
                                </div>
                            </div>
                            <!-- Content on bottom -->
                            <div class="p-6 flex-1 flex flex-col justify-center">
                                <h3 class="text-2xl md:text-3xl font-black @theme.Title mb-3">@s.TitleTr</h3>
                                <p class="text-gray-700 text-sm md:text-base font-semibold leading-relaxed">@s.DescriptionTr</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Small Card (Right) -->
                        <div class="md:col-span-1 md:row-span-1 relative rounded-[2rem] overflow-hidden group transition-all duration-500 hover:-translate-y-1 reveal flex flex-col h-full @theme.Bg @theme.Hover @theme.Shadow">
                            <div class="w-full h-36 md:h-[130px] overflow-hidden relative">
                                <img src="@s.ImageUrl" alt="@s.TitleTr" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                <div class="absolute top-4 right-4 w-10 h-10 rounded-xl @theme.BoxBg flex items-center justify-center @theme.Icon shadow-lg group-hover:scale-110 transition-transform z-10">
                                    @Html.Raw(s.IconSvg)
                                </div>
                            </div>
                            <div class="p-4 md:p-5 flex-1 flex flex-col justify-center">
                                <h3 class="text-lg md:text-xl font-bold @theme.Title mb-1">@s.TitleTr</h3>
                                <p class="text-gray-700 text-xs md:text-sm font-semibold line-clamp-2">@s.DescriptionTr</p>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
</section>

<!-- PROJELER (PORTFOLYO) -->
<section id="works" class="scroll-mt-20 py-24 px-4 relative overflow-hidden">
    <!-- Moving Dark Yellow / Amber Base -->
    <div class="absolute inset-0 z-0 bg-gradient-to-r from-yellow-400 via-amber-400 to-yellow-400 bg-[length:200%_auto] animate-[shine_8s_linear_infinite]"></div>
    <!-- Diamond Pattern Overlay -->
    <div class="absolute -inset-[100%] z-0 opacity-10 rotate-45 pointer-events-none" style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 50px 50px;"></div>
    
    <div class="max-w-6xl mx-auto relative z-10">
        <div class="mb-12 reveal text-center md:text-left">
            <span class="inline-block mb-3 px-5 py-1.5 rounded-full bg-gradient-to-r from-blue-900 via-indigo-700 to-blue-900 bg-[length:200%_auto] animate-[shine_6s_linear_infinite] text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-blue-900/20">PORTFOLYO</span>
            <h2 class="text-4xl md:text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-900 via-indigo-700 to-blue-900 bg-[length:200%_auto] animate-[shine_6s_linear_infinite]">
                İmza İşlerim
            </h2>
            <p class="text-gray-800 max-w-xl mx-auto md:mx-0 text-lg font-bold">Sıradan siteler değil, markalara dijital prestij kazandıran kurumsal projeler.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @if (ViewBag.Projects != null)
            {
                foreach (var project in (IEnumerable<AkuDevs.Models.Project>)ViewBag.Projects)
                {
                    <a href="@project.ProjectUrl" target="_blank" class="reveal group block rounded-[2rem] overflow-hidden bg-white border border-gray-100 hover:border-blue-900/30 hover:shadow-2xl hover:shadow-blue-900/10 transition-all duration-500 hover:-translate-y-1">
                        <div class="relative aspect-[4/3] overflow-hidden">
                            <img src="@project.ImageUrl" alt="@project.TitleTr" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        </div>
                        <div class="p-8">
                            <div class="mb-4">
                                <span class="px-4 py-1.5 bg-blue-50 text-blue-900 border border-blue-100 rounded-lg text-xs font-black uppercase tracking-wider">@project.CategoryTr</span>
                            </div>
                            <h3 class="text-2xl font-black text-slate-900 mb-3 group-hover:text-blue-800 transition-colors">@project.TitleTr</h3>
                            <p class="text-gray-600 text-sm mb-6 font-semibold line-clamp-3 leading-relaxed">@project.DescriptionTr</p>
                            <div class="text-amber-500 group-hover:text-amber-600 font-black text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
                                Projeyi İncele <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </div>
                        </div>
                    </a>
                }
            }
        </div>

        <div class="mt-16 text-center reveal">
            <a href="/Project" class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-blue-900 via-indigo-700 to-blue-900 bg-[length:200%_auto] animate-[shine_6s_linear_infinite] text-white font-black text-lg tracking-wide shadow-xl shadow-blue-900/30 hover:shadow-2xl hover:shadow-blue-900/40 hover:-translate-y-1 transition-all duration-300">
                Tüm Projeleri Gör
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
        </div>
    </div>
</section>

<!-- YETENEKLER -->
<section id="skills" class="scroll-mt-20 bg-white py-16 md:py-24 px-4">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12 md:mb-16 reveal">
            <span class="inline-block mb-3 px-5 py-1.5 rounded-full bg-gradient-to-r from-teal-500 via-emerald-400 to-teal-500 bg-[length:200%_auto] animate-[shine_6s_linear_infinite] text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-teal-500/20">YETENEKLER</span>
            <h2 class="text-4xl md:text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-teal-600 via-emerald-500 to-teal-600 bg-[length:200%_auto] animate-[shine_6s_linear_infinite]">
                Kullandığım Teknolojiler
            </h2>
            <p class="text-gray-600 max-w-2xl mx-auto text-base md:text-lg font-semibold">Hızlı, güvenli ve ölçeklenebilir projeler için modern ve kanıtlanmış araçlar.</p>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (ViewBag.Skills != null)
            {
                foreach (var skill in (IEnumerable<AkuDevs.Models.Skill>)ViewBag.Skills)
                {
                    <li class="reveal flex gap-4 md:gap-5 p-4 md:p-5 rounded-2xl border border-gray-100 bg-white hover:border-teal-400 hover:shadow-[0_0_15px_rgba(20,184,166,0.1)] transition-all cursor-pointer group">
                        <div class="shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-xl md:rounded-2xl text-white font-black text-lg md:text-xl flex items-center justify-center shadow-md transition-transform group-hover:scale-105" style="background-color: @skill.ColorHex;" aria-hidden="true">
                            @skill.IconText
                        </div>
                        <div class="flex flex-col justify-center">
                            <h3 class="font-bold text-slate-900 text-base md:text-lg mb-1 group-hover:text-teal-600 transition-colors">@skill.TitleTr</h3>
                            <p class="text-gray-600 text-xs md:text-sm font-semibold leading-relaxed">@skill.DescriptionTr</p>
                        </div>
                    </li>
                }
            }
        </ul>
    </div>
</section>

<!-- SÜREÇ VE İSTATİSTİKLER -->
<section id="process" class="scroll-mt-20 bg-gradient-to-b from-slate-50 to-slate-200/50 pt-24 pb-16 md:pb-24 px-4 relative">
    <div class="max-w-6xl mx-auto relative z-10">
        <div class="text-center mb-16 reveal">
            <span class="inline-block mb-3 px-5 py-1.5 rounded-full bg-gradient-to-r from-blue-600 via-cyan-500 to-blue-600 bg-[length:200%_auto] animate-[shine_6s_linear_infinite] text-white text-xs font-black uppercase tracking-widest shadow-lg shadow-blue-500/20">SÜREÇ</span>
            <h2 class="text-4xl md:text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-500 to-blue-600 bg-[length:200%_auto] animate-[shine_6s_linear_infinite]">
                Nasıl Çalışıyorum?
            </h2>
            <p class="text-gray-500 max-w-2xl mx-auto text-lg font-medium">Şeffaf, planlı ve sürpriz içermeyen dört adımlı bir süreç.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            @if (ViewBag.WorkProcesses != null)
            {
                var processes = ((IEnumerable<AkuDevs.Models.WorkProcess>)ViewBag.WorkProcesses).ToList();
                
                var sweetThemes = new[] {
                    new { Bg = "bg-blue-50/80 border-blue-100", Number = "text-blue-200 group-hover:text-blue-500", Title = "group-hover:text-blue-700", Hover = "hover:border-blue-300 hover:shadow-blue-500/20" },
                    new { Bg = "bg-emerald-50/80 border-emerald-100", Number = "text-emerald-200 group-hover:text-emerald-500", Title = "group-hover:text-emerald-700", Hover = "hover:border-emerald-300 hover:shadow-emerald-500/20" },
                    new { Bg = "bg-purple-50/80 border-purple-100", Number = "text-purple-200 group-hover:text-purple-500", Title = "group-hover:text-purple-700", Hover = "hover:border-purple-300 hover:shadow-purple-500/20" },
                    new { Bg = "bg-rose-50/80 border-rose-100", Number = "text-rose-200 group-hover:text-rose-500", Title = "group-hover:text-rose-700", Hover = "hover:border-rose-300 hover:shadow-rose-500/20" }
                };

                for (int i = 0; i < processes.Count; i++)
                {
                    var p = processes[i];
                    var theme = sweetThemes[i % sweetThemes.Length];
                    
                    <div class="reveal p-8 rounded-[2rem] @theme.Bg border-2 @theme.Hover hover:-translate-y-1 hover:shadow-xl transition-all duration-300 group cursor-pointer backdrop-blur-sm">
                        <div class="text-5xl font-black @theme.Number mb-6 transition-colors duration-500">@p.StepNumber</div>
                        <h3 class="font-bold text-slate-800 text-xl mb-3 @theme.Title transition-colors duration-300">@p.TitleTr</h3>
                        <p class="text-gray-500 text-sm font-medium leading-relaxed">@p.DescriptionTr</p>
                    </div>
                }
            }
        </div>
    </div>
    
    <!-- STATS PILL BANNER -->
    <div class="relative mt-12 md:mt-20 w-full md:w-[95%] max-w-5xl mx-auto z-30 reveal">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl md:rounded-full py-6 md:py-8 px-4 md:px-12 shadow-2xl shadow-slate-900/10 grid grid-cols-2 md:flex md:flex-row justify-between items-center md:divide-x divide-slate-700/50 gap-6 md:gap-0">
            @if (ViewBag.Statistics != null)
            {
                var stats = ((IEnumerable<AkuDevs.Models.Statistic>)ViewBag.Statistics).ToList();
                var statColors = new[] { "text-blue-400 drop-shadow-[0_0_8px_rgba(96,165,250,0.5)]", "text-emerald-400 drop-shadow-[0_0_8px_rgba(52,211,153,0.5)]", "text-purple-400 drop-shadow-[0_0_8px_rgba(192,132,252,0.5)]", "text-rose-400 drop-shadow-[0_0_8px_rgba(251,113,133,0.5)]" };
                
                for (int i = 0; i < stats.Count; i++)
                {
                    var stat = stats[i];
                    var c = statColors[i % statColors.Length];
                    
                    <div class="flex flex-col md:flex-row items-center text-center md:text-left gap-2 md:gap-4 px-2 md:px-6">
                        <div class="text-4xl md:text-5xl font-black @c">@stat.Value</div>
                        <div class="text-gray-300 font-bold uppercase text-xs tracking-widest leading-tight">
                            @Html.Raw(stat.TitleTr)
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- TESTIMONIALS (YORUMLAR) -->
<section id="testimonials" class="pt-32 pb-24 relative overflow-hidden flex flex-col items-center justify-center bg-gradient-to-br from-yellow-400 via-amber-400 to-yellow-500">
    <!-- ÖRÜMCEK AĞI (RADAR) DESENİ (SPIDER WEB MESH) -->
    <div class="absolute -inset-[100%] opacity-40 pointer-events-none animate-[spin_120s_linear_infinite]" style="background-image: repeating-radial-gradient(circle at center, rgba(255,255,255,0.7) 0, rgba(255,255,255,0.7) 1px, transparent 1px, transparent 60px), repeating-conic-gradient(rgba(255,255,255,0.4) 0 1deg, transparent 1deg 15deg);"></div>

    <div class="max-w-4xl mx-auto px-4 text-center z-10 mb-8 md:mb-12 reveal">
        <span class="inline-block mb-4 px-6 py-1.5 rounded-full border border-slate-900/10 bg-white/30 backdrop-blur-md shadow-sm text-transparent bg-clip-text bg-gradient-to-r from-slate-800 to-black bg-[length:200%_auto] animate-[shine_6s_linear_infinite] text-xs font-black uppercase tracking-widest">MEMNUNİYET</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-700 to-black bg-[length:200%_auto] animate-[shine_6s_linear_infinite] drop-shadow-sm">Geliştirdiğim Bağlar</h2>
        <p class="text-slate-800/90 text-base md:text-lg mb-8 max-w-xl mx-auto font-bold px-2">Müşterilerimin projeleriyle kurduğumuz uzun soluklu iş ortaklıkları hakkında ne düşündüklerini dinleyin.</p>
    </div>

    <!-- POKER CARDS CAROUSEL -->
    <div class="relative w-full max-w-3xl mx-auto h-[400px] flex items-center justify-center perspective-[1200px] mt-2 z-10">
        @if (ViewBag.Testimonials != null)
        {
            var tests = ((IEnumerable<AkuDevs.Models.Testimonial>)ViewBag.Testimonials).ToList();
            if (tests.Any())
            {
                for (int i = 0; i < tests.Count; i++)
                {
                    <article class="testimonial-card absolute w-[300px] sm:w-[380px] bg-white/95 backdrop-blur-md rounded-3xl p-8 shadow-2xl transition-all duration-700 ease-out cursor-pointer group border border-white/50" data-index="@i">
                        <div class="flex text-[#eab308] text-sm mb-4" aria-hidden="true">
                            @for (int s = 0; s < tests[i].Rating; s++)
                            {
                                <svg class="w-4 h-4 mr-1 drop-shadow-sm" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
